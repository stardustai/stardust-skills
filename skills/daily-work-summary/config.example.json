  "dingtalk": {"enabled": true, "profile": "", "queries": ["示例项目"], "nodes": [], "max_pages": 10, "max_documents": 50, "page_size": 20},
  "limits": {"timeout_seconds": 30, "max_content_chars": 20000}
}
