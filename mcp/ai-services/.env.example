AI_SERVICES_HOST=127.0.0.1
AI_SERVICES_PORT=8920
AI_SERVICES_MCP_PATH=/mcp

# OCR: the ocr-provider service (POST /v1/ocr)
AI_SERVICES_OCR_BASE_URL=http://127.0.0.1:7998/v1
AI_SERVICES_OCR_MODEL=
AI_SERVICES_OCR_API_KEY=
AI_SERVICES_OCR_TIMEOUT_SECONDS=300

# OCR engine=qwen (tables / complex layouts): the gateway's multimodal chat model.
# The key must be scoped to this model.
AI_SERVICES_OCR_QWEN_BASE_URL=http://127.0.0.1:8900/v1
AI_SERVICES_OCR_QWEN_MODEL=qwen3.8-27b
AI_SERVICES_OCR_QWEN_API_KEY=
AI_SERVICES_OCR_QWEN_REASONING_EFFORT=low
AI_SERVICES_OCR_QWEN_MAX_OUTPUT_TOKENS=8192
AI_SERVICES_OCR_QWEN_TIMEOUT_SECONDS=600
AI_SERVICES_OCR_QWEN_PDF_DPI=150
AI_SERVICES_OCR_QWEN_MAX_PAGES=20
AI_SERVICES_OCR_QWEN_CONCURRENCY=3

# ASR: OpenAI-compatible /audio/transcriptions (the gpu4 LiteLLM gateway)
AI_SERVICES_ASR_BASE_URL=http://127.0.0.1:8900/v1
AI_SERVICES_ASR_MODEL=qwen3-asr
AI_SERVICES_ASR_API_KEY=
AI_SERVICES_ASR_LANGUAGE=
AI_SERVICES_ASR_TIMEOUT_SECONDS=1800

# TTS: Qwen3-TTS through the same gpu4 LiteLLM gateway (/audio/speech, MP3 only).
# The key must be scoped to the TTS model; the ASR key cannot reach it.
AI_SERVICES_TTS_BASE_URL=http://127.0.0.1:8900/v1
AI_SERVICES_TTS_MODEL=qwen3-tts-1.7b-customvoice
AI_SERVICES_TTS_VOICE=Vivian
AI_SERVICES_TTS_API_KEY=
AI_SERVICES_TTS_TIMEOUT_SECONDS=300

# Comma-separated Host headers accepted by the MCP transport (add the public hostname)
AI_SERVICES_MCP_ALLOWED_HOSTS=127.0.0.1,localhost,127.0.0.1:*,localhost:*
